# Copy to .env and fill in. Never commit .env
NEXUS_HOST=nexus.example.com
NEXUS_PORT=8081
NEXUS_SCHEME=http            # http or https
NEXUS_REPO=pypi-group        # your Nexus pypi (proxy) or pypi (group) repo name
NEXUS_USERNAME=
NEXUS_PASSWORD=              # URL-encoding handled by the scripts
